# Copy this file to env and fill in your API key.
# cp env.example env

# DeepSeek API key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Log directory (actual logs written here)
LOG_DIR=/var/log/deepseek-proxy

# Symlink target (optional local convenience symlink, e.g. ~/.local/share/logs/deepseek-proxy)
# Leave empty to skip the symlink.
SYMLINK_LOG_DIR=
